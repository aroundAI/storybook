# ==================================
# HYBRID DEPLOYMENT CONFIGURATION
# ==================================
# Mix and match providers based on cost and requirements
# Example: Supabase DB + AWS S3 + SendGrid Email

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_PRODUCT_NAME=Your SaaS
NEXT_PUBLIC_SITE_TITLE="Your SaaS - Description"
NEXT_PUBLIC_SITE_DESCRIPTION="Your SaaS product description"
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR="#ffffff"
NEXT_PUBLIC_THEME_COLOR_DARK="#0a0a0a"

# ==================================
# PROVIDER CONFIGURATION (HYBRID)
# ==================================

# DATABASE: Supabase (best for rapid development, free tier)
DATABASE_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AUTH: Supabase (free, integrated with database)
AUTH_PROVIDER=supabase
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false

# STORAGE: Cloudflare R2 (no S3 adapter exists; the code supports r2 and supabase, KB-70)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-app-storage
R2_PUBLIC_URL=https://media.your-domain.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# EMAIL: SendGrid (reliable, good deliverability)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG....
EMAIL_SENDER=noreply@your-domain.com

# QUEUE: AWS SQS (pay per use, no infrastructure)
QUEUE_PROVIDER=sqs
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/your-queue

# REALTIME: Supabase (included with database)
REALTIME_PROVIDER=supabase

# CACHE: Redis (Upstash for serverless, $0.20/100K requests)
CACHE_PROVIDER=redis
REDIS_URL=redis://default:password@your-redis.upstash.io:6379

# ==================================
# BILLING
# ==================================
NEXT_PUBLIC_BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ==================================
# CMS
# ==================================
CMS_CLIENT=keystatic
NEXT_PUBLIC_KEYSTATIC_CONTENT_PATH=./content

# ==================================
# MONITORING
# ==================================
NEXT_PUBLIC_MONITORING_PROVIDER=sentry
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
INSTRUMENTATION_SERVICE_NAME=your-saas-production

# ==================================
# CAPTCHA
# ==================================
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_turnstile_site_key
CAPTCHA_SECRET_TOKEN=your_turnstile_secret

# ==================================
# FEATURE FLAGS
# ==================================
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=true
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_BILLING=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_DELETION=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_BILLING=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_CREATION=true
NEXT_PUBLIC_LANGUAGE_PRIORITY=application

# ==================================
# NEXTJS
# ==================================
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# ==================================
# COST OPTIMIZATION NOTES
# ==================================
# This hybrid setup optimizes for cost:
# - Supabase: Free tier covers 500MB DB + 1GB storage + auth
# - AWS S3: $0.023/GB (cheaper than Supabase beyond 1GB)
# - SendGrid: Free tier = 100 emails/day, then $19.95/40K emails
# - AWS SQS: $0.40/million requests (pay per use)
# - Upstash Redis: Free tier = 10K requests/day
#
# Estimated monthly cost for 10K users:
# - Supabase: $25/month (Pro plan)
# - AWS S3: ~$5/month (200GB storage)
# - SendGrid: $19.95/month (40K emails)
# - AWS SQS: $1/month (2.5M messages)
# - Upstash: $10/month (1M requests)
# Total: ~$60/month vs $175+ for full AWS
