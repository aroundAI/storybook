  },
  "navigation_guide": {
    "for_new_features": {
      "authentication": "Start with @kit/auth package",
      "user_features": "Use @kit/accounts for personal features",
      "team_features": "Use @kit/team-accounts for collaboration",
      "ui_components": "Import from @kit/ui",
      "database": "Use @kit/supabase clients",
      "payments": "Integrate via @kit/billing-gateway"
