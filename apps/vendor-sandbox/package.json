{
  "name": "vendor-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stand-ins for the vendors the app calls (FILM-1802, FILM-1803). Never deployed.",
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "start": "tsx src/main.ts",
    "seed-credentials": "tsx --conditions=react-server src/social/seed-credentials.ts",
    "workers": "esbuild src/queue/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=../../.sandbox/workers.cjs --log-level=warning && node ../../.sandbox/workers.cjs",
    "format": "prettier --check \"**/*.{ts,tsx,json}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "prettier": "@kit/prettier-config",
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.913.0",
    "@aws-sdk/client-dynamodb": "^3.913.0",
    "@aws-sdk/client-sqs": "^3.968.0",
    "@kit/prompt-engine": "workspace:*",
    "@kit/shared": "workspace:*",
    "ws": "^8.18.3",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@google/genai": "^1.34.0",
    "@kit/agent": "workspace:*",
    "@kit/audio-generation": "workspace:*",
    "@kit/content-analytics": "workspace:*",
    "@kit/episodes": "workspace:*",
    "@kit/eslint-config": "workspace:*",
    "@kit/llm": "workspace:*",
    "@kit/prettier-config": "workspace:*",
    "@kit/publishing": "workspace:*",
    "@kit/supabase": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@types/node": "^24.5.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
