{
  "extends": "@kit/tsconfig/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "types": [
      "node"
    ],
    "paths": {
      "@aws-sdk/client-s3": [
        "../../packages/features/storage/node_modules/@aws-sdk/client-s3"
      ],
      "@aws-sdk/client-sqs": [
        "../../packages/features/publishing/node_modules/@aws-sdk/client-sqs"
      ]
    }
  },
  "include": [
    "*.ts",
    "src",
    "__tests__"
  ],
  "exclude": [
    "node_modules"
  ]
}
