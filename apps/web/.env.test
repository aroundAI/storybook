# CRON JOB SECURITY
# The cron routes refuse every request without this, so a spec driving one
# against a production build gets "Server configuration error" rather than
# the route. Mirrors .env.development; not a secret, and the test Supabase
# it reaches is local.
CRON_SECRET=dev-secret

# ANALYTICS SCOPES (FILM-1711)
# Which platforms' connect requests carry the analytics scopes #289 added:
# youtube, tiktok, meta (Instagram and Facebook). Unset is none, the
# pre-FILM-1711 request. Local runs and tests use all three; production turns
# each on after its consent-screen check (docs/vendor-review-runbook.md, Part 1).
ANALYTICS_SCOPES_ENABLED=youtube,tiktok,meta
