# SHARED ENVIROMENT VARIABLES
# HERE YOU CAN ADD ALL THE **PUBLIC** ENVIRONMENT VARIABLES THAT ARE SHARED ACROSS ALL THE ENVIROMENTS
# PLEASE DO NOT ADD ANY CONFIDENTIAL KEYS OR SENSITIVE INFORMATION HERE
# ONLY CONFIGURATION, PATH, FEATURE FLAGS, ETC.
# TO OVERRIDE THESE VARIABLES IN A SPECIFIC ENVIRONMENT, PLEASE ADD THEM TO THE SPECIFIC ENVIRONMENT FILE (e.g. .env.development, .env.production)

# SITE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=AAIKit
NEXT_PUBLIC_SITE_TITLE="AAIKit - AI SaaS Starter Kit"
NEXT_PUBLIC_SITE_DESCRIPTION="Build production-ready AI applications faster with AAIKit. The complete Next.js starter for AI-powered SaaS with built-in LLM integration, prompt management, and AI workflows."
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR="#ffffff"
NEXT_PUBLIC_THEME_COLOR_DARK="#0a0a0a"

# AUTH
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# BILLING
NEXT_PUBLIC_BILLING_PROVIDER=stripe

# CMS
CMS_CLIENT=keystatic

# KEYSTATIC
NEXT_PUBLIC_KEYSTATIC_CONTENT_PATH=./content

# LOCALES PATH
NEXT_PUBLIC_LOCALES_PATH=apps/web/public/locales

# FEATURE FLAGS
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=true
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_BILLING=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_DELETION=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_BILLING=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_CREATION=true
NEXT_PUBLIC_LANGUAGE_PRIORITY=application

# NEXTJS
NEXT_TELEMETRY_DISABLED=1

# ===================================
# AI SAAS BRANDING - AAIKit
# ===================================
# Use case: AI SaaS starter kit, developer tools, AI applications
# Personality: Modern, creative, approachable, innovative
# Target: Developers, AI startups, SaaS builders
# Inspiration: OpenAI, Anthropic, Vercel, Supabase

# ===================================
# LOGO CONFIGURATION
# ===================================

# SaaS/Productivity Tool Branding Example
# Use case: Project management, productivity tools, team collaboration
# Personality: Playful yet professional, innovative
# Target: Creative teams and tech-savvy professionals

# Logo Configuration
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="AroundAIKit"
NEXT_PUBLIC_LOGO_FONT="Quicksand"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=700
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#6366f1
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#a5b4fc
NEXT_PUBLIC_LOGO_ICON="🛍️"

# Brand Colors
# Primary: Purple for innovation and creativity
# Secondary: Cyan for technology and efficiency
# Accent: Orange for energy and action
NEXT_PUBLIC_BRAND_PRIMARY=#6366f1
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#4f46e5
NEXT_PUBLIC_BRAND_SECONDARY=#06b6d4
NEXT_PUBLIC_BRAND_ACCENT=#f97316

# Typography
# Quicksand for friendly, approachable headings
# Inter for clean, readable body text
NEXT_PUBLIC_FONT_HEADING=Quicksand
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=600,700
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# Icon Style
# Outline style for modern, clean interface
NEXT_PUBLIC_ICON_STYLE=outline
NEXT_PUBLIC_ICON_STROKE_WIDTH=2

# Metadata
NEXT_PUBLIC_BRAND_PERSONALITY=playful
NEXT_PUBLIC_APP_CATEGORY=saas
