# ==================================
# AWS DEPLOYMENT CONFIGURATION
# ==================================
# This configuration uses AWS services for a fully AWS-managed stack
# Suitable for production deployments on AWS with complete control

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_PRODUCT_NAME=Your SaaS
NEXT_PUBLIC_SITE_TITLE="Your SaaS - Description"
NEXT_PUBLIC_SITE_DESCRIPTION="Your SaaS product description"
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR="#ffffff"
NEXT_PUBLIC_THEME_COLOR_DARK="#0a0a0a"

# ==================================
# PROVIDER CONFIGURATION
# ==================================

# DATABASE: AWS RDS PostgreSQL
DATABASE_PROVIDER=postgresql
POSTGRES_HOST=your-db.xxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=your_database
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password

# AUTH: AWS Cognito
AUTH_PROVIDER=cognito
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your_client_id
COGNITO_CLIENT_SECRET=your_client_secret
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false

# STORAGE: Cloudflare R2 (no S3 adapter exists; the code supports r2 and supabase, KB-70)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-app-storage
R2_PUBLIC_URL=https://media.your-domain.com
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# EMAIL: AWS SES
EMAIL_PROVIDER=ses
EMAIL_SENDER=noreply@your-domain.com
# AWS credentials are shared with storage (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)

# QUEUE: AWS SQS
QUEUE_PROVIDER=sqs
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/your-queue
# AWS credentials are shared with storage

# CACHE: Redis (AWS ElastiCache)
CACHE_PROVIDER=redis
REDIS_URL=redis://your-redis.xxxxx.cache.amazonaws.com:6379

# REALTIME: WebSocket (API Gateway WebSocket)
REALTIME_PROVIDER=websocket
WEBSOCKET_URL=wss://your-api.execute-api.us-east-1.amazonaws.com/production

# ==================================
# BILLING
# ==================================
NEXT_PUBLIC_BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ==================================
# CMS
# ==================================
CMS_CLIENT=keystatic
NEXT_PUBLIC_KEYSTATIC_CONTENT_PATH=./content

# ==================================
# MONITORING
# ==================================
NEXT_PUBLIC_MONITORING_PROVIDER=sentry
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
INSTRUMENTATION_SERVICE_NAME=your-saas-production

# ==================================
# CAPTCHA
# ==================================
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_turnstile_site_key
CAPTCHA_SECRET_TOKEN=your_turnstile_secret

# ==================================
# FEATURE FLAGS
# ==================================
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=true
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_BILLING=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_DELETION=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_BILLING=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_CREATION=true
NEXT_PUBLIC_LANGUAGE_PRIORITY=application

# ==================================
# NEXTJS
# ==================================
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# ==================================
# AWS DEPLOYMENT SPECIFIC
# ==================================
# These are used by OpenNext for Lambda deployment
AWS_LAMBDA_FUNCTION_NAME=your-saas-main
AWS_LAMBDA_FUNCTION_MEMORY_SIZE=1024
AWS_LAMBDA_FUNCTION_TIMEOUT=30

# CloudFront Distribution
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# API Gateway
API_GATEWAY_ID=abcdef1234

# ==================================
# WEBHOOKS
# ==================================
SUPABASE_DB_WEBHOOK_SECRET=your_webhook_secret
