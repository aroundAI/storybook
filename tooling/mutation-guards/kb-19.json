      "kind": "unit",
      "file": "apps/web/lib/platforms/connect-failure.ts",
      "find": "  return CONNECT_FAILURE_CODES.some((code) => code === value);",
      "replace": "  return typeof value === 'string';",
      "cwd": "apps/web",
      "test": "lib/platforms/__tests__/connect-failure.test.ts",
      "pattern": "does not echo"
    },
    {
      "name": "D2 Vendor text is shown for failures no vendor reported",
      "kind": "unit",
      "file": "apps/web/lib/platforms/connect-failure.ts",
      "find": "  const showsVendorText = SHOWS_VENDOR_TEXT.has(code);",
      "replace": "  const showsVendorText = true;",
      "cwd": "apps/web",
      "test": "lib/platforms/__tests__/connect-failure.test.ts",
      "pattern": "no vendor reported"
    },
    {
      "name": "D3 Vendor text from the address is shown at any length",
      "kind": "unit",
      "file": "apps/web/lib/platforms/connect-failure.ts",
      "find": "          first(searchParams.vendor_message),\n          VENDOR_MESSAGE_MAX_LENGTH,",
      "replace": "          first(searchParams.vendor_message),\n          Infinity,",
      "cwd": "apps/web",
      "test": "lib/platforms/__tests__/connect-failure.test.ts",
      "pattern": "caps vendor text again"
    },
    {
      "name": "D4 A refused scope under a vendor's own name reads as a generic error",
      "kind": "unit",
      "file": "apps/web/lib/platforms/connect-failure.ts",
      "find": "  return normalised.includes('scope') ? 'invalid_scope' : 'vendor_error';",
      "replace": "  return 'vendor_error';",
      "cwd": "apps/web",
      "test": "lib/platforms/__tests__/connect-failure.test.ts",
      "pattern": "scope_not_authorized"
    },
    {
      "name": "D5 The scope-refused message stops mentioning the review",
      "kind": "unit",
      "file": "apps/web/public/locales/en/platforms.json",
      "find": " The app’s review for that permission may not be approved yet.",
      "replace": "",
      "cwd": "apps/web",
      "test": "lib/platforms/__tests__/connect-failure.test.ts",
      "pattern": "unapproved review"
    },
    {
      "name": "D6 A failure code is added without a message",
      "kind": "unit",
      "file": "apps/web/lib/platforms/connect-failure.ts",
      "find": "  'storage_failed',\n",
      "replace": "  'storage_failed',\n  'quota_exceeded',\n",
      "cwd": "apps/web",
      "test": "lib/platforms/__tests__/connect-failure.test.ts",
      "pattern": "for every code"
    },
    {
      "name": "E1 The vendor's words are rendered as markup",
      "kind": "unit",
      "file": "apps/web/components/platform-connect-failure.tsx",
      "find": "              >\n                {failure.vendorMessage}\n              </p>",
      "replace": "                dangerouslySetInnerHTML={{ __html: failure.vendorMessage }}\n              />",
      "cwd": "apps/web",
      "test": "components/__tests__/platform-connect-failure.test.tsx",
      "pattern": "never as markup"
    }
  ]
}
