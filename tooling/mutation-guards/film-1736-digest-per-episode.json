      "pattern": "groups each episode",
      "kind": "unit",
      "cwd": "packages/features/content-analytics",
      "test": "__tests__/daily-digest-per-episode.test.ts"
    },
    {
      "name": "DPE2 episodes oldest first",
      "file": "packages/features/content-analytics/src/lib/daily-digest.ts",
