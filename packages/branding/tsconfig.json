{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "lib": [
            "ES2022"
        ],
        "module": "ESNext",
        "target": "ES2022"
    },
    "include": [
        "src/**/*",
        "__tests__"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
