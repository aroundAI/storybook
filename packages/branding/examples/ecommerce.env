# E-commerce/Retail Branding Example
# Use case: Online stores, marketplace platforms, retail apps
# Personality: Bold and energetic, attention-grabbing
# Target: General consumers, online shoppers

# Logo Configuration
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="ShopFlow"
NEXT_PUBLIC_LOGO_FONT="Montserrat"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=800
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#dc2626
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#f87171
NEXT_PUBLIC_LOGO_ICON="🛍️"

# Brand Colors
# Primary: Red for urgency and excitement
# Secondary: Teal for trust and quality
# Accent: Yellow for attention and value/deals
NEXT_PUBLIC_BRAND_PRIMARY=#dc2626
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#b91c1c
NEXT_PUBLIC_BRAND_SECONDARY=#14b8a6
NEXT_PUBLIC_BRAND_ACCENT=#fbbf24

# Typography
# Montserrat for bold, impactful headings
# Inter for clean product descriptions
NEXT_PUBLIC_FONT_HEADING=Montserrat
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=700,800,900
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# Icon Style
# Solid style for friendly, consumer-friendly interface
NEXT_PUBLIC_ICON_STYLE=solid
NEXT_PUBLIC_ICON_STROKE_WIDTH=2

# Metadata
NEXT_PUBLIC_BRAND_PERSONALITY=bold
NEXT_PUBLIC_APP_CATEGORY=ecommerce
