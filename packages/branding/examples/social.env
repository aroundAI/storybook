# Social Media/Networking Branding Example
# Use case: Social networks, community platforms, messaging apps
# Personality: Playful and vibrant, connection-focused
# Target: Gen Z and millennials, social media users

# Logo Configuration
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="Conecta"
NEXT_PUBLIC_LOGO_FONT="Nunito"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=800
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#ec4899
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#f9a8d4
NEXT_PUBLIC_LOGO_ICON="💬"

# Brand Colors
# Primary: Pink for connection and warmth
# Secondary: Purple for creativity and expression
# Accent: Cyan for communication and interaction
NEXT_PUBLIC_BRAND_PRIMARY=#ec4899
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#db2777
NEXT_PUBLIC_BRAND_SECONDARY=#8b5cf6
NEXT_PUBLIC_BRAND_ACCENT=#06b6d4

# Typography
# Nunito for friendly, social headings
# Inter for readable messages and content
NEXT_PUBLIC_FONT_HEADING=Nunito
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=700,800
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# Icon Style
# Solid style for friendly, approachable interface
NEXT_PUBLIC_ICON_STYLE=solid
NEXT_PUBLIC_ICON_STROKE_WIDTH=2

# Metadata
NEXT_PUBLIC_BRAND_PERSONALITY=playful
NEXT_PUBLIC_APP_CATEGORY=social
