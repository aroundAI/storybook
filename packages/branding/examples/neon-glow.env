# Neon Glow Logo Example (Cyberpunk Style)
# Use case: Gaming platforms, entertainment, creative apps
# Effect: Vibrant neon glow with pulsing animation
# Inspired by: Cyberpunk aesthetics, neon signage, retro-futurism

# ===================================
# LOGO CONFIGURATION
# ===================================

# Logo Type & Text
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="NEONFLOW"
NEXT_PUBLIC_LOGO_FONT="Montserrat"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=900
NEXT_PUBLIC_LOGO_ICON="⚡"

# Logo Colors
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#00F5FF
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#00F5FF

# ===================================
# NEON GRADIENT EFFECT
# ===================================

# Neon gradient (cyan to magenta)
NEXT_PUBLIC_LOGO_GRADIENT_ENABLED=true
NEXT_PUBLIC_LOGO_GRADIENT_PRESET=neon
NEXT_PUBLIC_LOGO_GRADIENT_ANIMATE=true

# ===================================
# GLOW EFFECT (Neon Intensity)
# ===================================

# Intense neon glow with pulsing animation
NEXT_PUBLIC_LOGO_GLOW_ENABLED=true
NEXT_PUBLIC_LOGO_GLOW_COLOR=#FF00FF
NEXT_PUBLIC_LOGO_GLOW_INTENSITY=neon
NEXT_PUBLIC_LOGO_GLOW_ANIMATE=true

# ===================================
# BRAND COLORS
# ===================================

# Primary: Electric cyan
# Secondary: Neon magenta
# Accent: Bright yellow
NEXT_PUBLIC_BRAND_PRIMARY=#00F5FF
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#00B8D4
NEXT_PUBLIC_BRAND_SECONDARY=#FF00FF
NEXT_PUBLIC_BRAND_ACCENT=#FFFF00

# ===================================
# TYPOGRAPHY
# ===================================

# Montserrat for bold, impactful headers
# Inter for readable body text
NEXT_PUBLIC_FONT_HEADING=Montserrat
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=700,800,900
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# ===================================
# ICON STYLE
# ===================================

NEXT_PUBLIC_ICON_STYLE=solid
NEXT_PUBLIC_ICON_STROKE_WIDTH=2.5

# ===================================
# METADATA
# ===================================

NEXT_PUBLIC_BRAND_PERSONALITY=bold
NEXT_PUBLIC_APP_CATEGORY=social

# ===================================
# USAGE NOTES
# ===================================

# This configuration creates an intense neon glow effect perfect for
# gaming, entertainment, or creative platforms. The logo combines:
# - Vibrant neon gradient (cyan to magenta)
# - Intense glow effect with pulsing animation
# - Bold, all-caps typography for maximum impact
#
# Best for: Gaming platforms, entertainment apps, creative tools, nightlife
# Effect: Dramatic neon glow with dual animations (gradient + pulse)
# Performance: Moderate (CSS animations only, GPU-accelerated)
# Warning: High visual impact - ensure accessibility considerations
