# SaaS/Productivity Tool Branding Example
# Use case: Project management, productivity tools, team collaboration
# Personality: Playful yet professional, innovative
# Target: Creative teams and tech-savvy professionals

# Logo Configuration
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="Sparkboard"
NEXT_PUBLIC_LOGO_FONT="Quicksand"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=700
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#6366f1
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#a5b4fc
NEXT_PUBLIC_LOGO_ICON="✨"

# Brand Colors
# Primary: Purple for innovation and creativity
# Secondary: Cyan for technology and efficiency
# Accent: Orange for energy and action
NEXT_PUBLIC_BRAND_PRIMARY=#6366f1
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#4f46e5
NEXT_PUBLIC_BRAND_SECONDARY=#06b6d4
NEXT_PUBLIC_BRAND_ACCENT=#f97316

# Typography
# Quicksand for friendly, approachable headings
# Inter for clean, readable body text
NEXT_PUBLIC_FONT_HEADING=Quicksand
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=600,700
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# Icon Style
# Outline style for modern, clean interface
NEXT_PUBLIC_ICON_STYLE=outline
NEXT_PUBLIC_ICON_STROKE_WIDTH=2

# Metadata
NEXT_PUBLIC_BRAND_PERSONALITY=playful
NEXT_PUBLIC_APP_CATEGORY=saas
