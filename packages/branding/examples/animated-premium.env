# Animated Premium Logo Example (All Effects Combined)
# Use case: Premium brands, luxury products, high-end SaaS
# Effect: Gradient + Glow + Animation for maximum visual impact
# Inspired by: Luxury brands, premium products, high-end tech

# ===================================
# LOGO CONFIGURATION
# ===================================

# Logo Type & Text
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="LUXE"
NEXT_PUBLIC_LOGO_FONT="Playfair Display"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=900
NEXT_PUBLIC_LOGO_ICON="✨"

# Logo Colors (fallback)
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#C9A050
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#FFD700

# ===================================
# GRADIENT EFFECT (Animated Gold)
# ===================================

# Luxury gold gradient with smooth animation
NEXT_PUBLIC_LOGO_GRADIENT_ENABLED=true
NEXT_PUBLIC_LOGO_GRADIENT_TYPE=linear
NEXT_PUBLIC_LOGO_GRADIENT_COLORS=#C9A050,#FFD700,#C9A050
NEXT_PUBLIC_LOGO_GRADIENT_DIRECTION=to right
NEXT_PUBLIC_LOGO_GRADIENT_ANIMATE=true

# ===================================
# GLOW EFFECT (Subtle Luxury Shimmer)
# ===================================

# Subtle gold glow with pulsing animation
NEXT_PUBLIC_LOGO_GLOW_ENABLED=true
NEXT_PUBLIC_LOGO_GLOW_COLOR=#FFD700
NEXT_PUBLIC_LOGO_GLOW_INTENSITY=medium
NEXT_PUBLIC_LOGO_GLOW_ANIMATE=true

# ===================================
# OPTIONAL: TEXT STROKE
# ===================================

# Uncomment to add dark outline (creates more depth)
# NEXT_PUBLIC_LOGO_STROKE_ENABLED=true
# NEXT_PUBLIC_LOGO_STROKE_WIDTH=1
# NEXT_PUBLIC_LOGO_STROKE_COLOR=#8B7355

# ===================================
# BRAND COLORS
# ===================================

# Primary: Luxury gold
# Secondary: Deep purple (royalty)
# Accent: Rose gold
NEXT_PUBLIC_BRAND_PRIMARY=#C9A050
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#A88840
NEXT_PUBLIC_BRAND_SECONDARY=#6B46C1
NEXT_PUBLIC_BRAND_ACCENT=#E0B0A2

# ===================================
# TYPOGRAPHY
# ===================================

# Playfair Display for elegant, luxury headings
# Lora for sophisticated body text
NEXT_PUBLIC_FONT_HEADING=Playfair Display
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=600,700,900
NEXT_PUBLIC_FONT_BODY=Lora
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# ===================================
# ICON STYLE
# ===================================

NEXT_PUBLIC_ICON_STYLE=outline
NEXT_PUBLIC_ICON_STROKE_WIDTH=1.5

# ===================================
# METADATA
# ===================================

NEXT_PUBLIC_BRAND_PERSONALITY=elegant
NEXT_PUBLIC_APP_CATEGORY=ecommerce

# ===================================
# USAGE NOTES
# ===================================

# This configuration showcases ALL animation and styling features:
# - Animated gradient (gold shimmer effect)
# - Pulsing glow (subtle luxury shimmer)
# - Serif typography for elegance
# - Optional stroke for added depth
#
# The combination creates a premium, luxurious feel perfect for:
# - High-end e-commerce
# - Luxury services
# - Premium SaaS products
# - Exclusive memberships
#
# Best for: Luxury brands, premium products, high-end services
# Effect: Animated gradient with pulsing glow (dual animations)
# Performance: Moderate (GPU-accelerated CSS animations)
#
# Notes:
# - Both animations run simultaneously
# - Gradient shifts smoothly across text
# - Glow pulses subtly for shimmer effect
# - Serif font adds sophistication
#
# Customization tips:
# - Adjust glow intensity (subtle/medium/strong/neon)
# - Change gradient colors for different moods
# - Add stroke for more definition
# - Try different serif fonts (Cormorant, Merriweather)
