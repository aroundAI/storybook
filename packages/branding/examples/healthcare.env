# Healthcare/Wellness App Branding Example
# Use case: Fitness tracking, telemedicine, wellness apps, health records
# Personality: Playful yet professional, approachable
# Target: Health-conscious individuals, wellness enthusiasts

# Logo Configuration
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="FitFlow"
NEXT_PUBLIC_LOGO_FONT="Nunito"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=800
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#0891b2
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#67e8f9
NEXT_PUBLIC_LOGO_ICON="💪"

# Brand Colors
# Primary: Cyan for health, calm, and vitality
# Secondary: Green for healing and nature
# Accent: Purple for care and compassion
NEXT_PUBLIC_BRAND_PRIMARY=#0891b2
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#0e7490
NEXT_PUBLIC_BRAND_SECONDARY=#10b981
NEXT_PUBLIC_BRAND_ACCENT=#8b5cf6

# Typography
# Nunito for soft, approachable headings
# Inter for readable health information
NEXT_PUBLIC_FONT_HEADING=Nunito
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=700,800
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# Icon Style
# Outline style for approachable, friendly interface
NEXT_PUBLIC_ICON_STYLE=outline
NEXT_PUBLIC_ICON_STROKE_WIDTH=2

# Metadata
NEXT_PUBLIC_BRAND_PERSONALITY=playful
NEXT_PUBLIC_APP_CATEGORY=healthcare
