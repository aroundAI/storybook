# Modern Gradient Logo Example (MakerKit-style)
# Use case: Modern SaaS, tech startups, developer tools
# Effect: Blue to purple gradient text with subtle animation
# Inspired by: MakerKit, Vercel, Linear

# ===================================
# LOGO CONFIGURATION
# ===================================

# Logo Type & Text
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="MakerKit"
NEXT_PUBLIC_LOGO_FONT="Inter"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=800
NEXT_PUBLIC_LOGO_ICON="⚡"

# Logo Colors (fallback for non-gradient displays)
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#667eea
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#a5b4fc

# ===================================
# GRADIENT EFFECT
# ===================================

# Gradient Configuration
NEXT_PUBLIC_LOGO_GRADIENT_ENABLED=true
NEXT_PUBLIC_LOGO_GRADIENT_PRESET=purple-blue
# OR use custom colors (uncomment to override preset):
# NEXT_PUBLIC_LOGO_GRADIENT_TYPE=linear
# NEXT_PUBLIC_LOGO_GRADIENT_COLORS=#667eea,#764ba2
# NEXT_PUBLIC_LOGO_GRADIENT_DIRECTION=to right

# Animated gradient (subtle shifting effect)
NEXT_PUBLIC_LOGO_GRADIENT_ANIMATE=true

# ===================================
# BRAND COLORS
# ===================================

# Primary: Professional purple
# Secondary: Tech cyan
# Accent: Energetic orange
NEXT_PUBLIC_BRAND_PRIMARY=#667eea
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#5568d3
NEXT_PUBLIC_BRAND_SECONDARY=#06b6d4
NEXT_PUBLIC_BRAND_ACCENT=#f97316

# ===================================
# TYPOGRAPHY
# ===================================

# Inter for modern, clean typography
NEXT_PUBLIC_FONT_HEADING=Inter
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=600,700,800
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# ===================================
# ICON STYLE
# ===================================

NEXT_PUBLIC_ICON_STYLE=outline
NEXT_PUBLIC_ICON_STROKE_WIDTH=2

# ===================================
# METADATA
# ===================================

NEXT_PUBLIC_BRAND_PERSONALITY=professional
NEXT_PUBLIC_APP_CATEGORY=saas

# ===================================
# USAGE NOTES
# ===================================

# This configuration creates a professional gradient logo similar to MakerKit,
# with a subtle blue-to-purple gradient and smooth animation. The gradient
# uses the 'purple-blue' preset for consistency.
#
# Best for: Modern SaaS platforms, developer tools, tech startups
# Effect: Professional gradient text with smooth animation
# Performance: Minimal impact (CSS-based animation)
