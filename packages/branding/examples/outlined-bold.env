# Outlined Bold Logo Example (Text Stroke Style)
# Use case: Sports brands, lifestyle brands, streetwear
# Effect: Bold outlined text with high contrast
# Inspired by: Sports logos, streetwear brands, bold typography

# ===================================
# LOGO CONFIGURATION
# ===================================

# Logo Type & Text
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="BOLDFIT"
NEXT_PUBLIC_LOGO_FONT="Montserrat"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=900
NEXT_PUBLIC_LOGO_ICON="💪"

# Logo Colors (white fill with dark outline)
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#FFFFFF
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#FFFFFF

# ===================================
# TEXT STROKE/OUTLINE EFFECT
# ===================================

# Bold dark outline around white text
NEXT_PUBLIC_LOGO_STROKE_ENABLED=true
NEXT_PUBLIC_LOGO_STROKE_WIDTH=2
NEXT_PUBLIC_LOGO_STROKE_COLOR=#000000

# ===================================
# OPTIONAL: ADD GRADIENT TO STROKE
# ===================================

# Uncomment to add gradient fill inside the outline
# NEXT_PUBLIC_LOGO_GRADIENT_ENABLED=true
# NEXT_PUBLIC_LOGO_GRADIENT_TYPE=linear
# NEXT_PUBLIC_LOGO_GRADIENT_COLORS=#FF512F,#F09819
# NEXT_PUBLIC_LOGO_GRADIENT_DIRECTION=to bottom right

# ===================================
# BRAND COLORS
# ===================================

# Primary: Energetic red
# Secondary: Dark charcoal
# Accent: Bright yellow
NEXT_PUBLIC_BRAND_PRIMARY=#dc2626
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#b91c1c
NEXT_PUBLIC_BRAND_SECONDARY=#1f2937
NEXT_PUBLIC_BRAND_ACCENT=#fbbf24

# ===================================
# TYPOGRAPHY
# ===================================

# Montserrat for bold, athletic typography
NEXT_PUBLIC_FONT_HEADING=Montserrat
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=700,800,900
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# ===================================
# ICON STYLE
# ===================================

NEXT_PUBLIC_ICON_STYLE=solid
NEXT_PUBLIC_ICON_STROKE_WIDTH=3

# ===================================
# METADATA
# ===================================

NEXT_PUBLIC_BRAND_PERSONALITY=bold
NEXT_PUBLIC_APP_CATEGORY=ecommerce

# ===================================
# USAGE NOTES
# ===================================

# This configuration creates a bold outlined logo perfect for sports,
# fitness, or lifestyle brands. The logo features:
# - White text with dark outline (high contrast)
# - Heavy font weight for maximum impact
# - Optional gradient fill (uncomment to enable)
#
# Best for: Sports brands, fitness apps, lifestyle products, streetwear
# Effect: Bold, high-contrast outlined text
# Performance: Minimal impact (pure CSS)
#
# Variation ideas:
# - Change stroke color to match brand primary
# - Add gradient fill inside the outline
# - Combine with subtle glow for more depth
