# Education/Learning Platform Branding Example
# Use case: Online courses, educational platforms, e-learning
# Personality: Playful and engaging, knowledge-focused
# Target: Students, lifelong learners, educators

# Logo Configuration
NEXT_PUBLIC_LOGO_TYPE=text
NEXT_PUBLIC_LOGO_TEXT="LearnHub"
NEXT_PUBLIC_LOGO_FONT="Quicksand"
NEXT_PUBLIC_LOGO_FONT_WEIGHT=700
NEXT_PUBLIC_LOGO_TEXT_COLOR_LIGHT=#4f46e5
NEXT_PUBLIC_LOGO_TEXT_COLOR_DARK=#a78bfa
NEXT_PUBLIC_LOGO_ICON="📚"

# Brand Colors
# Primary: Indigo for knowledge and wisdom
# Secondary: Amber for energy and curiosity
# Accent: Pink for creativity and engagement
NEXT_PUBLIC_BRAND_PRIMARY=#4f46e5
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#4338ca
NEXT_PUBLIC_BRAND_SECONDARY=#f59e0b
NEXT_PUBLIC_BRAND_ACCENT=#ec4899

# Typography
# Quicksand for friendly, inviting headings
# Inter for clear, readable content
NEXT_PUBLIC_FONT_HEADING=Quicksand
NEXT_PUBLIC_FONT_HEADING_WEIGHTS=600,700
NEXT_PUBLIC_FONT_BODY=Inter
NEXT_PUBLIC_FONT_BODY_WEIGHTS=400,500,600

# Icon Style
# Outline style for playful, educational interface
NEXT_PUBLIC_ICON_STYLE=outline
NEXT_PUBLIC_ICON_STROKE_WIDTH=2

# Metadata
NEXT_PUBLIC_BRAND_PERSONALITY=playful
NEXT_PUBLIC_APP_CATEGORY=education
