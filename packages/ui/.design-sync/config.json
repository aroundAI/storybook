    "EnhancedDataTable": "src/makerkit/data-table.tsx",
    "MobileNavigationDropdown": null,
    "AuthenticityToken": null,
    "Dropzone": null,
    "DropzoneContent": null,
    "DropzoneEmptyState": null,
    "LazyRender": null,
    "ImageUploadInput": null,
