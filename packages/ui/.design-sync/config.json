  "dtsPropsFor": {
    "ShadcnSidebar": "className?: string; children?: unknown; side?: 'left' | 'right'; variant?: 'sidebar' | 'floating' | 'inset' | 'ghost'; collapsible?: 'offcanvas' | 'icon' | 'none';",
    "ShadcnSidebarContent": "className?: string; children?: unknown;",
    "ShadcnSidebarGroup": "className?: string; children?: unknown;",
    "ShadcnSidebarNavigation": "config: { routes: Array<Record<string, unknown>> };"
  },
  "libOverrides": {
    "source-kit.mjs": "src/shadcn/{sidebar,data-table}.tsx and src/makerkit/{sidebar,data-table}.tsx export overlapping names (Sidebar/SidebarContent/SidebarGroup/SidebarNavigation, DataTable); ESM export* drops the ambiguous bindings, so the synth entry aliases the secondary copy of each pair (Shadcn* / EnhancedDataTable)",
    "dts.mjs": "package ships no .d.ts tree at all (synth-entry mode), so unmodified projectFor() adds zero source files and every component gets the generic prop stub; fork also parses the package's own .tsx source when the .d.ts glob finds nothing"
  },
