{
  "name": "@kit/prompt-templates",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "format": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "exports": {
    "./components": "./src/components/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./schemas": "./src/lib/schemas/prompt.schema.ts",
    "./types": "./src/lib/types.ts",
    "./mutations": "./src/lib/server/prompt.mutations.ts",
    "./queries": "./src/lib/server/prompt.queries.ts",
    "./server": "./src/lib/server/index.ts",
    "./engine": "./src/lib/engine/index.ts",
    "./engine/parser": "./src/lib/engine/parser.ts",
    "./engine/validator": "./src/lib/engine/validator.ts",
    "./engine/renderer": "./src/lib/engine/renderer.ts",
    "./engine/composer": "./src/lib/engine/composer.ts"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@kit/audit-logs": "workspace:*",
    "@kit/eslint-config": "workspace:*",
    "@kit/llm": "workspace:*",
    "@kit/monitoring": "workspace:*",
    "@kit/next": "workspace:*",
    "@kit/prettier-config": "workspace:*",
    "@kit/shared": "workspace:*",
    "@kit/supabase": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@kit/ui": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-query": "5.89.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.3",
    "zod": "^3.25.74"
  },
  "prettier": "@kit/prettier-config",
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  }
}
