{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kit.dev/schemas/timeline/v1.0.json",
  "title": "Timeline",
  "description": "Video timeline schema for stitching multiple clips with transitions and audio",
  "type": "object",
  "required": ["id", "version", "duration", "tracks", "renderSettings"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the timeline"
    },
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version"
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "Total duration of the timeline in seconds"
    },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/definitions/Track" },
      "description": "All tracks in the timeline"
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/definitions/Transition" },
      "default": [],
      "description": "Transitions between clips"
    },
    "renderSettings": {
      "$ref": "#/definitions/RenderSettings",
      "description": "Output render settings"
    },
    "metadata": {
      "$ref": "#/definitions/TimelineMetadata",
      "description": "Optional timeline metadata"
    }
  },
  "definitions": {
    "TrackType": {
      "type": "string",
      "enum": ["video", "dialogue", "music", "sfx", "ambient"]
    },
    "TransitionType": {
      "type": "string",
      "enum": ["cut", "fade", "crossfade", "wipe", "dissolve", "slide"]
    },
    "VideoCodec": {
      "type": "string",
      "enum": ["h264", "h265", "vp9", "prores"]
    },
    "AudioCodec": {
      "type": "string",
      "enum": ["aac", "mp3", "opus", "pcm"]
    },
    "OutputFormat": {
      "type": "string",
      "enum": ["mp4", "webm", "mov", "mkv"]
    },
    "RenderQuality": {
      "type": "string",
      "enum": ["draft", "standard", "high"]
    },
    "WipeDirection": {
      "type": "string",
      "enum": ["left", "right", "up", "down", "radial"]
    },
    "Clip": {
      "type": "object",
      "required": ["id", "trackId", "assetUrl", "name", "startTime", "duration"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "trackId": {
          "type": "string"
        },
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "assetUrl": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "startTime": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceStart": {
          "type": "number",
          "minimum": 0
        },
        "sourceEnd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0
        },
        "thumbnailUrl": {
          "type": "string",
          "format": "uri"
        },
        "isPlaceholder": {
          "type": "boolean",
          "default": false
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Track": {
      "type": "object",
      "required": ["id", "type", "name", "clips"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/TrackType"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clips": {
          "type": "array",
          "items": { "$ref": "#/definitions/Clip" }
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "isMuted": {
          "type": "boolean",
          "default": false
        },
        "isLocked": {
          "type": "boolean",
          "default": false
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TransitionParams": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/definitions/WipeDirection"
        },
        "easing": {
          "type": "string"
        },
        "custom": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Transition": {
      "type": "object",
      "required": ["id", "type", "clipBeforeId", "clipAfterId", "duration"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "$ref": "#/definitions/TransitionType"
        },
        "clipBeforeId": {
          "type": "string",
          "format": "uuid"
        },
        "clipAfterId": {
          "type": "string",
          "format": "uuid"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "params": {
          "$ref": "#/definitions/TransitionParams"
        }
      }
    },
    "RenderSettings": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7680,
          "default": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4320,
          "default": 1080
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 30
        },
        "codec": {
          "$ref": "#/definitions/VideoCodec",
          "default": "h264"
        },
        "audioCodec": {
          "$ref": "#/definitions/AudioCodec",
          "default": "aac"
        },
        "format": {
          "$ref": "#/definitions/OutputFormat",
          "default": "mp4"
        },
        "quality": {
          "$ref": "#/definitions/RenderQuality",
          "default": "standard"
        },
        "videoBitrate": {
          "type": "integer",
          "minimum": 1
        },
        "audioBitrate": {
          "type": "integer",
          "minimum": 1,
          "default": 192
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1,
          "default": 48000
        },
        "includeAudio": {
          "type": "boolean",
          "default": true
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        }
      }
    },
    "TimelineMetadata": {
      "type": "object",
      "properties": {
        "episodeId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "accountId": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "custom": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
