{
    "name": "@kit/storage",
    "version": "0.1.0",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./client": "./src/client.ts",
        "./buckets": "./src/buckets.ts",
        "./upload-paths": "./src/upload-paths.ts",
        "./public-url": "./src/public-url.ts",
        "./episode-video": "./src/episode-video.ts",
        "./adapters/local": "./src/adapters/local.ts",
        "./adapters/supabase": "./src/adapters/supabase.ts"
    },
    "scripts": {
        "format": "prettier --check \"**/*.{ts,tsx}\"",
        "clean": "rm -rf .turbo node_modules",
        "lint": "eslint .",
        "test": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.964.0",
        "@aws-sdk/s3-request-presigner": "^3.965.0",
        "mime-types": "^2.1.35",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@kit/prettier-config": "workspace:*",
        "@supabase/supabase-js": "2.57.4",
        "@types/mime-types": "^2.1.4",
        "@types/node": "^24.5.0",
        "eslint": "^9.35.0",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4"
    },
    "prettier": "@kit/prettier-config"
}
