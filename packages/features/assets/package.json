{
  "name": "@kit/assets",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "format": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./server": "./src/lib/server/index.ts",
    "./mutations": "./src/lib/server/asset.mutations.ts",
    "./queries": "./src/lib/server/asset.queries.ts",
    "./lib": "./src/lib/index.ts",
    "./schemas": "./src/lib/schemas/index.ts",
    "./types": "./src/lib/types.ts",
    "./hooks": "./src/hooks/index.ts",
    "./upload-validation": "./src/lib/upload-validation.ts",
    "./upload": "./src/lib/upload/index.ts",
    "./character-schemas": "./src/lib/schemas/character.schema.ts",
    "./character-types": "./src/lib/types/character.types.ts",
    "./element-prompt": "./src/lib/element-prompt/index.ts",
    "./character/schemas": "./src/lib/schemas/character.schema.ts",
    "./character/server": "./src/lib/server/character.mutations.ts",
    "./character/queries": "./src/lib/server/character.queries.ts"
  },
  "devDependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@kit/eslint-config": "workspace:*",
    "@kit/prettier-config": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@kit/ui": "workspace:*",
    "@supabase/supabase-js": "2.57.4",
    "@types/node": "^24.5.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^3.25.74"
  },
  "prettier": "@kit/prettier-config",
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "dependencies": {
    "@kit/cache": "workspace:*",
    "@kit/llm": "workspace:*",
    "@kit/next": "workspace:*",
    "@kit/shared": "workspace:*",
    "@kit/storage": "workspace:*",
    "@kit/supabase": "workspace:*",
    "@tanstack/react-query": "5.89.0",
    "lucide-react": "^0.544.0",
    "react-dropzone": "^14.3.8",
    "sharp": "^0.33.5"
  }
}