    "./hooks/*": "./src/hooks/*.ts",
    "./schemas": "./src/lib/schemas/project.schema.ts",
    "./types": "./src/lib/types.ts",
    "./mutations": "./src/lib/server/project.mutations.ts",
    "./queries": "./src/lib/server/project.queries.ts"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@kit/audit-logs": "workspace:*",
    "@kit/cache": "workspace:*",
    "@kit/eslint-config": "workspace:*",
    "@kit/film-studio-schemas": "workspace:*",
    "@kit/monitoring": "workspace:*",
    "@kit/next": "workspace:*",
    "@kit/prettier-config": "workspace:*",
    "@kit/shared": "workspace:*",
    "@kit/supabase": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@kit/ui": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-query": "5.89.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.3",
    "vitest": "^3.2.4",
    "zod": "^3.25.74"
