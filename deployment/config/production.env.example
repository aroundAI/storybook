# Deployment Configuration - Production
# Copy this file to production.env and fill in your values

# ==============================================================================
# Deployment Settings
# ==============================================================================
DEPLOY_TARGET=lambda
NODE_ENV=production

# ==============================================================================
# AWS Configuration
# ==============================================================================
AWS_REGION=us-east-1
# AWS credentials will be loaded from aws configure or environment variables
# AWS_ACCESS_KEY_ID=<your-aws-access-key>
# AWS_SECRET_ACCESS_KEY=<your-aws-secret-key>

# ==============================================================================
# Domain Configuration (Required for production)
# ==============================================================================
DOMAIN_NAME=yourdomain.com
# HOSTED_ZONE_ID=<auto-discovered-if-not-set>
# SKIP_DOMAIN=false

# ==============================================================================
# Supabase Configuration (Required)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Recommended for production: Automatic migrations
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_ACCESS_TOKEN=your-access-token

# ==============================================================================
# Site Configuration
# ==============================================================================
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_PRODUCT_NAME=Your SaaS
NEXT_PUBLIC_SITE_DESCRIPTION=Your SaaS Application

# ==============================================================================
# Email Configuration
# ==============================================================================
EMAIL_PROVIDER=ses
EMAIL_SENDER=noreply@yourdomain.com
# AWS_SES_CONFIG_SET=<auto-generated-by-sst>

# ==============================================================================
# Infrastructure Providers
# ==============================================================================
STORAGE_PROVIDER=s3
QUEUE_PROVIDER=sqs
REALTIME_PROVIDER=websocket

# ==============================================================================
# Monitoring & Analytics (Recommended for production)
# ==============================================================================
# SENTRY_DSN=your-sentry-dsn
# NEXT_PUBLIC_SENTRY_DSN=your-public-sentry-dsn
