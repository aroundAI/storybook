# Deployment Configuration - Tailorist.dev
# Copy this file to tailorist.env and fill in your values

# ==============================================================================
# Deployment Settings
# ==============================================================================
DEPLOY_TARGET=lambda
NODE_ENV=production

# ==============================================================================
# AWS Configuration
# ==============================================================================
AWS_REGION=us-east-1
# AWS credentials will be loaded from aws configure or environment variables

# ==============================================================================
# Domain Configuration
# ==============================================================================
DOMAIN_NAME=tailorist.dev
# HOSTED_ZONE_ID=<will-be-auto-discovered>

# ==============================================================================
# Supabase Configuration
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-tailorist-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# For automatic migrations
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_ACCESS_TOKEN=your-access-token

# ==============================================================================
# Site Configuration
# ==============================================================================
NEXT_PUBLIC_SITE_URL=https://tailorist.dev
NEXT_PUBLIC_PRODUCT_NAME=Tailorist
NEXT_PUBLIC_SITE_DESCRIPTION=AI-powered tailoring platform

# ==============================================================================
# Email Configuration
# ==============================================================================
EMAIL_PROVIDER=ses
EMAIL_SENDER=noreply@tailorist.dev

# ==============================================================================
# Infrastructure Providers
# ==============================================================================
STORAGE_PROVIDER=s3
QUEUE_PROVIDER=sqs
REALTIME_PROVIDER=websocket
